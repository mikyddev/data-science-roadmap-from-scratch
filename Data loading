        "import pandas as pd\n",
        "\n",
        "# 1. Carregar o arquivo CSV\n",
        "# Nota: O Colab já vem com um arquivo de exemplo na pasta 'sample_data'\n",
        "url = 'https://raw.githubusercontent.com/mwaskom/seaborn-data/master/iris.csv'\n",
        "df = pd.read_csv(url)\n",
        "\n",
        "# 2. Visualizar as 5 primeiras linhas\n",
        "print(\"--- Primeiras Linhas ---\")\n",
        "print(df.head())\n",
        "\n",
        "# 3. Verificar informações das colunas e tipos de dados\n",
        "print(\"\\n--- Informações do Dataset ---\")\n",
        "print(df.info())\n",
        "\n",
        "# 4. Filtrar dados e salvar um novo arquivo CSV\n",
        "df_filtrado = df[df['species'] == 'setosa']\n",
        "df_filtrado.to_csv('dados_setosa.csv', index=False)\n",
